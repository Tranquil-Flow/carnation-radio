# carnation-radio Forge — TESTNET deployment environment variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git — it is listed in .gitignore.

# ------------------------------------------------------------
# Deployer private key (no 0x prefix needed for Foundry scripts)
# Used by forge script --private-key $PRIVATE_KEY
# ------------------------------------------------------------
PRIVATE_KEY=<REPLACE_WITH_DEPLOYER_PRIVATE_KEY>

# ------------------------------------------------------------
# Sepolia RPC URL
# Referenced in foundry.toml [rpc_endpoints] as ${SEPOLIA_RPC_URL}
# Get one from: https://alchemy.com, https://infura.io, or use a public endpoint
# e.g. https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# ------------------------------------------------------------
SEPOLIA_RPC_URL=<REPLACE_WITH_SEPOLIA_RPC_URL>

# ------------------------------------------------------------
# Etherscan API key for contract verification on Sepolia
# Referenced in foundry.toml [etherscan] as ${ETHERSCAN_API_KEY}
# Get one at: https://etherscan.io/myapikey
# ------------------------------------------------------------
ETHERSCAN_API_KEY=<REPLACE_WITH_ETHERSCAN_API_KEY>
